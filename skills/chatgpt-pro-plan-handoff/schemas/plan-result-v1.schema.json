{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.plan-result/v1",
  "type": "object",
  "required": ["schema", "workflow_id", "stage", "attempt_index", "nonce", "question_sha256", "source_snapshot_sha256", "status", "sections"],
  "properties": {
    "schema": {"const": "codex.chatgpt.plan-result/v1"},
    "workflow_id": {"type": "string"},
    "stage": {"enum": ["pro-plan", "gpt-plan"]},
    "attempt_index": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string"},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "complete"},
    "sections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
