{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.goal-host-gates/v1",
  "type": "object",
  "required": ["schema", "goal_id", "cycle_index", "decision", "contract_valid", "semantic_criteria_passed", "implementation_complete", "blockers_absent", "checks", "accepted", "verified_at"],
  "properties": {
    "schema": {"const": "codex.chatgpt.goal-host-gates/v1"},
    "goal_id": {"type": "string"},
    "cycle_index": {"type": "integer", "minimum": 1, "maximum": 20},
    "decision": {"enum": ["CONTINUE", "GOAL_COMPLETE"]},
    "contract_valid": {"const": true},
    "semantic_criteria_passed": {"type": "boolean"},
    "implementation_complete": {"type": "boolean"},
    "blockers_absent": {"type": "boolean"},
    "checks": {"type": "array", "items": {"type": "object"}},
    "accepted": {"type": "boolean"},
    "verified_at": {"type": "string"}
  },
  "additionalProperties": false
}
