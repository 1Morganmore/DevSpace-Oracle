{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.parallel-implementation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "test_registry", "full_test_ids", "max_units"],
  "properties": {
    "enabled": {"const": true},
    "max_units": {"type": "integer", "minimum": 1, "maximum": 64},
    "test_registry": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "timeout_seconds"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
          "cwd": {"type": "string", "pattern": "^(?!/|[A-Za-z]:|.*(?:^|/)[.][.](?:/|$)).+$"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    },
    "full_test_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
    "allowed_claim_roots": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/|[A-Za-z]:|.*(?:^|/)[.][.](?:/|$)).+$"}}
  }
}
