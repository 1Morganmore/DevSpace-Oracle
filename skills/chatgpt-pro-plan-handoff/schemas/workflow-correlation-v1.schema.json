{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.workflow-correlation/v1",
  "type": "object",
  "required": ["schema", "workflow_id", "stage", "attempt_index", "nonce", "question_sha256", "source_snapshot_sha256"],
  "properties": {
    "schema": {"const": "codex.chatgpt.workflow-correlation/v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["pro-plan", "gpt-plan", "gpt-review", "gpt-orchestrator"]},
    "attempt_index": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string", "minLength": 16},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
