{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.goal-supervisor/v1",
  "type": "object",
  "required": ["schema", "goal_id", "goal", "project", "context", "gates", "acceptance", "policy"],
  "properties": {
    "schema": {"const": "codex.chatgpt.goal-supervisor/v1"},
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000000},
    "project": {
      "type": "object",
      "required": ["root", "chatgpt_app_name", "allowed_write_paths"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "chatgpt_app_name": {"type": "string", "minLength": 1},
        "allowed_write_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}},
        "handoff_root": {"type": "string"},
        "automation_repo_root": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["candidate_paths"],
      "properties": {
        "candidate_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "policy_paths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "gates": {"type": "object", "required": ["research", "advisory"]},
    "acceptance": {
      "type": "object",
      "required": ["criteria", "required_check_ids"],
      "properties": {
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_check_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "max_cycles": {"type": "integer", "minimum": 1, "maximum": 20, "default": 20},
        "stagnation_limit": {"type": "integer", "minimum": 2, "maximum": 10, "default": 3},
        "automatic_repair": {"type": "boolean", "default": false},
        "repair_attempts_per_family": {"type": "integer", "minimum": 0, "maximum": 2, "default": 2},
        "target_commit": {"type": "boolean", "default": false},
        "target_push": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "output_dir": {"type": "string"},
    "agbrowse_contract": {"type": "string"},
    "check_registry": {"$ref": "#/$defs/artifactRef"}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
