{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.implementation-graph-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "units"],
  "properties": {
    "schema": {"const": "codex.chatgpt.implementation-graph-result/v1"},
    "units": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_id", "required", "mission", "claimed_paths", "depends_on", "test_ids"],
        "properties": {
          "unit_id": {"$ref": "#/$defs/id"},
          "required": {"type": "boolean"},
          "mission": {"type": "string", "minLength": 1, "maxLength": 200000},
          "claimed_paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
          "depends_on": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "test_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "path": {"type": "string", "pattern": "^(?!/|[A-Za-z]:|.*(?:^|/)[.][.](?:/|$)|[.]git(?:/|$)).+$", "maxLength": 1024}
  }
}
