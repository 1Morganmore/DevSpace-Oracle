{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.stage-relay/v1",
  "$defs": {
    "bindings": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "revisionDelta": {
      "type": "object",
      "required": ["required_changes", "conditions", "evidence_gaps", "preserve"],
      "properties": {
        "required_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "preserve": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "workflow_id", "from_stage", "attempt_index", "nonce", "next_stage", "prompt_profile", "input_bindings", "next_prompt_body"],
      "properties": {
        "schema": {"const": "codex.chatgpt.stage-relay/v1"},
        "workflow_id": {"type": "string", "minLength": 1},
        "from_stage": {"const": "gpt-plan"},
        "attempt_index": {"type": "integer", "minimum": 1},
        "nonce": {"type": "string", "minLength": 16},
        "next_stage": {"const": "gpt-review"},
        "prompt_profile": {"const": "review"},
        "input_bindings": {"$ref": "#/$defs/bindings"},
        "next_prompt_body": {"type": "string", "minLength": 1, "maxLength": 200000}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema", "workflow_id", "from_stage", "attempt_index", "nonce", "next_stage", "prompt_profile", "input_bindings", "next_prompt_body", "review_prompt_body"],
      "properties": {
        "schema": {"const": "codex.chatgpt.stage-relay/v1"},
        "workflow_id": {"type": "string", "minLength": 1},
        "from_stage": {"const": "gpt-plan"},
        "attempt_index": {"type": "integer", "minimum": 1},
        "nonce": {"type": "string", "minLength": 16},
        "next_stage": {"const": "web-multi-advisory"},
        "prompt_profile": {"const": "web-branch-designer"},
        "input_bindings": {"$ref": "#/$defs/bindings"},
        "next_prompt_body": {"type": "string", "minLength": 1, "maxLength": 200000},
        "review_prompt_body": {"type": "string", "minLength": 1, "maxLength": 200000}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema", "workflow_id", "from_stage", "attempt_index", "nonce", "next_stage", "prompt_profile", "input_bindings", "next_prompt_body", "mission_body"],
      "properties": {
        "schema": {"const": "codex.chatgpt.stage-relay/v1"},
        "workflow_id": {"type": "string", "minLength": 1},
        "from_stage": {"const": "gpt-review"},
        "attempt_index": {"type": "integer", "minimum": 1},
        "nonce": {"type": "string", "minLength": 16},
        "next_stage": {"const": "gpt-orchestrator"},
        "prompt_profile": {"const": "orchestrator"},
        "input_bindings": {"$ref": "#/$defs/bindings"},
        "next_prompt_body": {"type": "string", "minLength": 1, "maxLength": 200000},
        "mission_body": {"type": "string", "minLength": 1, "maxLength": 200000}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema", "workflow_id", "from_stage", "attempt_index", "nonce", "next_stage", "prompt_profile", "input_bindings", "next_prompt_body", "revision_delta"],
      "properties": {
        "schema": {"const": "codex.chatgpt.stage-relay/v1"},
        "workflow_id": {"type": "string", "minLength": 1},
        "from_stage": {"const": "gpt-review"},
        "attempt_index": {"type": "integer", "minimum": 1},
        "nonce": {"type": "string", "minLength": 16},
        "next_stage": {"const": "gpt-plan"},
        "prompt_profile": {"const": "plan"},
        "input_bindings": {"$ref": "#/$defs/bindings"},
        "next_prompt_body": {"type": "string", "minLength": 1, "maxLength": 200000},
        "revision_delta": {"$ref": "#/$defs/revisionDelta"}
      },
      "additionalProperties": false
    }
  ]
}
