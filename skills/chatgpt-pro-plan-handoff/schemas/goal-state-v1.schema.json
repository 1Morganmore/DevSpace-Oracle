{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.goal-state/v1",
  "type": "object",
  "required": ["schema", "goal_id", "manifest_sha256", "revision", "phase", "cycle_index", "max_cycles", "active_action", "active_workflow", "last_cycle_result", "last_host_gates", "repair_families", "progress_fingerprints", "boundary", "final", "created_at", "updated_at"],
  "properties": {
    "schema": {"const": "codex.chatgpt.goal-state/v1"},
    "goal_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["CREATED", "CYCLE_READY", "WEB_ACTIVE", "HOST_VERIFYING", "REPAIR_ACTIVE", "WAITING_USER", "GOAL_COMPLETE", "FAILED_CLOSED"]},
    "cycle_index": {"type": "integer", "minimum": 0, "maximum": 20},
    "max_cycles": {"type": "integer", "minimum": 1, "maximum": 20},
    "active_action": {"type": ["object", "null"]},
    "active_workflow": {"type": ["object", "null"]},
    "last_cycle_result": {"type": ["object", "null"]},
    "last_host_gates": {"type": ["object", "null"]},
    "repair_families": {"type": "object"},
    "progress_fingerprints": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "boundary": {"type": ["object", "null"]},
    "final": {"type": ["object", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
