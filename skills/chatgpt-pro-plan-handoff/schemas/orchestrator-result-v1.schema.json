{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.orchestrator-result/v1",
  "type": "object",
  "required": ["schema", "workflow_id", "stage", "attempt_index", "nonce", "question_sha256", "source_snapshot_sha256", "input_plan_sha256", "status", "changed_files", "commands", "blockers"],
  "properties": {
    "schema": {"const": "codex.chatgpt.orchestrator-result/v1"},
    "workflow_id": {"type": "string"},
    "stage": {"const": "gpt-orchestrator"},
    "attempt_index": {"const": 1},
    "nonce": {"type": "string"},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_review_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "blocked", "stale-or-conflicted"]},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
