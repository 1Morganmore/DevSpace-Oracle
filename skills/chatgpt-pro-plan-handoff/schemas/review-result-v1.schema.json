{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.review-result/v1",
  "type": "object",
  "required": ["schema", "workflow_id", "stage", "attempt_index", "nonce", "question_sha256", "source_snapshot_sha256", "input_plan_sha256", "verdict"],
  "properties": {
    "schema": {"const": "codex.chatgpt.review-result/v1"},
    "workflow_id": {"type": "string"},
    "stage": {"const": "gpt-review"},
    "attempt_index": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string"},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["PASS", "REVISE", "BLOCK"]}
  },
  "additionalProperties": true
}
