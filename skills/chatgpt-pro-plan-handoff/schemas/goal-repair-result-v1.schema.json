{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.goal-repair-result/v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "summary",
    "changed_files",
    "focused_tests",
    "exact_run_preserved",
    "new_submission_created",
    "installation_synced",
    "source_committed",
    "source_pushed",
    "ci_passed"
  ],
  "properties": {
    "schema": {"const": "codex.chatgpt.goal-repair-result/v1"},
    "status": {"enum": ["COMPLETE", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "focused_tests": {"type": "array", "items": {"type": "string"}},
    "exact_run_preserved": {"type": "boolean"},
    "new_submission_created": {"type": "boolean"},
    "installation_synced": {"type": "boolean"},
    "source_committed": {"type": "boolean"},
    "source_pushed": {"type": "boolean"},
    "ci_passed": {"type": "boolean"}
  },
  "additionalProperties": false
}
