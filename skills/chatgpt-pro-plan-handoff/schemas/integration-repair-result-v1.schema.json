{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.integration-repair-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component_id", "repair_id", "input_head_oid", "status", "summary", "changed_paths", "test_results"],
  "properties": {
    "schema": {"const": "codex.chatgpt.integration-repair-result/v1"},
    "component_id": {"$ref": "#/$defs/id"},
    "repair_id": {"$ref": "#/$defs/id"},
    "input_head_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "status": {"enum": ["REPAIRED", "NO_CHANGE", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 20000},
    "changed_paths": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "test_results": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["test_id", "result"], "properties": {"test_id": {"$ref": "#/$defs/id"}, "result": {"enum": ["PASS", "FAIL", "SKIP"]}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "path": {"type": "string", "pattern": "^(?!/|[A-Za-z]:|.*(?:^|/)[.][.](?:/|$)|[.]git(?:/|$)).+$", "maxLength": 1024}
  }
}
