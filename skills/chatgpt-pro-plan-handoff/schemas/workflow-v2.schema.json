{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.comprehensive-workflow/v2",
  "type": "object",
  "required": ["schema", "workflow_mode", "workflow_id", "question", "workspace", "context", "gates"],
  "properties": {
    "schema": {"const": "codex.chatgpt.comprehensive-workflow/v2"},
    "workflow_mode": {"const": "gpt-comprehensive"},
    "workflow_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "agbrowse_contract": {"type": "string", "minLength": 1},
    "workspace": {
      "type": "object",
      "required": ["root", "allowed_write_paths", "chatgpt_app_name"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "handoff_root": {"type": "string"},
        "chatgpt_app_name": {"type": "string", "minLength": 1},
        "chatgpt_app_decision_path": {"type": "string"},
        "chatgpt_app_server_url": {"type": "string"},
        "allowed_write_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["candidate_paths"],
      "properties": {
        "candidate_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "policy_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": ["research", "advisory"],
      "properties": {
        "research": {"$ref": "#/$defs/researchGate"},
        "advisory": {"$ref": "#/$defs/advisoryGate"}
      },
      "additionalProperties": false
    },
    "pro_plan": {
      "type": "object",
      "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 5}},
      "additionalProperties": false
    },
    "web_multi_gpt": {
      "type": "object",
      "properties": {"max_iterations": {"type": "integer", "minimum": 1, "maximum": 5}},
      "additionalProperties": false
    },
    "review": {"type": "object", "additionalProperties": false},
    "stale_guard": {"type": "object", "additionalProperties": true},
    "output_dir": {"type": "string"}
  },
  "$defs": {
    "researchGate": {
      "type": "object",
      "required": ["policy", "triggers"],
      "properties": {
        "policy": {"enum": ["auto", "require", "skip"]},
        "triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["explicit_request", "current_external_facts", "broad_source_synthesis", "legal", "market", "standards", "recommendation_uncertainty"]}
        }
      },
      "additionalProperties": false
    },
    "advisoryGate": {
      "type": "object",
      "required": ["policy", "triggers", "affected_components", "cross_component_interfaces", "contradiction_evidence"],
      "properties": {
        "policy": {"enum": ["auto", "require", "skip"]},
        "triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["explicit_request", "verified_contradiction_evidence", "affected_components", "cross_component_interfaces", "security", "privacy", "credentials", "legal", "financial", "irreversible_external_state", "shared_routing", "schema_migration", "public_release"]}
        },
        "affected_components": {"type": "integer", "minimum": 0},
        "cross_component_interfaces": {"type": "integer", "minimum": 0},
        "contradiction_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
