{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.handoff/v1",
  "type": "object",
  "required": ["schema", "workflow_id", "state", "question_sha256", "source_snapshot_sha256", "plan", "consumer"],
  "properties": {
    "schema": {"const": "codex.chatgpt.handoff/v1"},
    "workflow_id": {"type": "string"},
    "state": {"const": "PLAN_READY"},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "review": {"type": ["object", "null"]},
    "consumer": {
      "type": "object",
      "required": ["stage", "workflow_correlation"],
      "properties": {
        "stage": {"const": "gpt-orchestrator"},
        "workflow_correlation": {"$ref": "workflow-correlation-v1.schema.json"}
      }
    }
  },
  "additionalProperties": true
}
