{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.chatgpt.plan-result/v2",
  "type": "object",
  "required": ["schema", "workflow_id", "stage", "attempt_index", "nonce", "question_sha256", "source_snapshot_sha256", "status", "input_research_descriptor_sha256", "sections"],
  "properties": {
    "schema": {"const": "codex.chatgpt.plan-result/v2"},
    "workflow_id": {"type": "string", "minLength": 1},
    "stage": {"const": "gpt-plan"},
    "attempt_index": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string", "minLength": 16},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "complete"},
    "input_research_descriptor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sections": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
